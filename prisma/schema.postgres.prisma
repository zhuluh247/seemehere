// Production schema for Neon Postgres (used when deploying to Render).
// The dev schema (schema.prisma) uses SQLite for the sandbox environment.
// New tables/columns for existing deployments: run the SQL block in README-DEPLOY.md step 4b.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Accounts (v1.1) — optional username + password, no email ───────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  drafts       Draft[]
}

model Draft {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String   @default("My CV")
  templateId    String   @default("modern")
  themeJson     String   @default("{}")
  cvJson        String
  photoData     String   @default("")
  portfolioJson String   @default("{}")
  publishedUser String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Published CV snapshots for public share pages (cv/{username})
model PublishedCv {
  id            String   @id @default(cuid())
  username      String   @unique
  claimKeyHash  String   @default("")
  ownerUserId   String?
  displayName   String
  templateId    String   @default("modern")
  themeJson     String   @default("{}")
  cvJson        String
  photoData     String   @default("")
  portfolioJson String   @default("{}")
  viewCount     Int      @default(0)
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// R4 — privacy-light page-view analytics (no IPs / fingerprints stored)
model PageView {
  id        String   @id @default(cuid())
  username  String
  mode      String   @default("cv")
  referrer  String   @default("")
  createdAt DateTime @default(now())

  @@index([username])
  @@index([createdAt])
}

// R4 — admin-editable site settings (SEO defaults etc.)
model SiteSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}
